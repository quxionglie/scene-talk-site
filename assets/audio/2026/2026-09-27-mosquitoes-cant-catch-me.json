            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Tu ne bougeais pas tout le temps ?",
          "file": "elevenlabs/fr-fr/2026-09-27-mosquitoes-cant-catch-me_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:55:20+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Parfois, je ne bougeais pas.",
          "file": "elevenlabs/fr-fr/2026-09-27-mosquitoes-cant-catch-me_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:55:22+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "older brother"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Et toi, petit frère ?",
          "file": "elevenlabs/fr-fr/2026-09-27-mosquitoes-cant-catch-me_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:55:23+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Moi, j'ai fait de la balançoire sans arrêt !",
          "file": "elevenlabs/fr-fr/2026-09-27-mosquitoes-cant-catch-me_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:55:25+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "GgV5QStPLpmkN7FOHJtY",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Tu t'es donc balancé sans arrêt et les moustiques n'arrivaient pas à te rattraper, c'est ça ?",
          "file": "elevenlabs/fr-fr/2026-09-27-mosquitoes-cant-catch-me_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:55:27+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Si le moustique est derrière moi, je me balance vers l'avant. S'il est devant, je me balance vers l'arrière.",
          "file": "elevenlabs/fr-fr/2026-09-27-mosquitoes-cant-catch-me_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
