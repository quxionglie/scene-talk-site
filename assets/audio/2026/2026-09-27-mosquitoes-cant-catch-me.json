            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "older brother"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "And what about you?",
          "file": "elevenlabs/en-us/2026-09-27-mosquitoes-cant-catch-me_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-27T18:07:10+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "I kept swinging the whole time!",
          "file": "elevenlabs/en-us/2026-09-27-mosquitoes-cant-catch-me_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-27T18:07:13+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "l7kNoIfnJKPg7779LI2t",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "So you kept swinging and the mosquitoes couldn't catch you. Is that it?",
          "file": "elevenlabs/en-us/2026-09-27-mosquitoes-cant-catch-me_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-27T18:07:15+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "If a mosquito is behind me, I swing forward. If it's in front of me, I swing back.",
          "file": "elevenlabs/en-us/2026-09-27-mosquitoes-cant-catch-me_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
