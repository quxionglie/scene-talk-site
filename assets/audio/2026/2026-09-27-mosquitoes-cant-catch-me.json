        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Weren't you moving around the whole time?",
          "file": "elevenlabs/en-us/2026-09-27-mosquitoes-cant-catch-me_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
