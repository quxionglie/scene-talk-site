      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "蚊子追不上我",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "你不是一直在动吗？",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "有时候没动。",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "哥哥"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "那弟弟你呢？",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "我就一直荡秋千啊！",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "弟弟"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "一直荡秋千所以蚊子追不上你，是这样子吗？",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "要是蚊子在后面，我就荡在前面。它在前面我就荡到后面。",
          "file": "zh-cn/2026-09-27-mosquitoes-cant-catch-me_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "弟弟"
        }
      ]
