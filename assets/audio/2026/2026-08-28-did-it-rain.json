          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "现在骗子真多。一个、两个、三个。",
          "file": "zh-cn/2026-08-28-did-it-rain_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "下雨了，地板不是湿了吗？",
          "file": "zh-cn/2026-08-28-did-it-rain_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "洒水车洒的水，我刚才看到了。",
          "file": "zh-cn/2026-08-28-did-it-rain_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "还真是喔！",
