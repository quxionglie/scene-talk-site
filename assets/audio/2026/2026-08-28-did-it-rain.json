          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "哪里有下雨吗？",
          "file": "zh-cn/2026-08-28-did-it-rain_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "母亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "骗你的。",
