          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "I want to put it on the windowsill when I go to bed.",
          "file": "elevenlabs/en-us/2026-08-05-land-rover-and-parking-space_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
