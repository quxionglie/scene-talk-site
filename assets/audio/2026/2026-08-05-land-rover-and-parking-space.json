            "provider": "ElevenLabs",
            "voice_id": "RgXx32WYOGrd7gFNifSf",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¿Qué significa «Lu Hu»?",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:59:46+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Un tigre al borde de la carretera.",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:59:48+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Es un todoterreno.",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:59:49+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Esta es vuestra plaza de aparcamiento. A partir de ahora, dejad el coche aquí, ¿vale?",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:59:51+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Cuando duerma, quiero dejarlo en el alféizar de la ventana.",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:59:53+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Como quieras. Pero ten cuidado cuando lo saques. Tiene mucha potencia, así que no atropelles a nadie.",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
