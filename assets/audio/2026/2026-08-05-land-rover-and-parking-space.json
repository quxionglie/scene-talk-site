          },
          "sequence": "002",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Un tigre au bord de la route.",
          "file": "elevenlabs/fr-fr/2026-08-05-land-rover-and-parking-space_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
