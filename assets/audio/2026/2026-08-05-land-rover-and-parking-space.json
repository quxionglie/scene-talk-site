        {
          "segment_id": "title",
          "type": "title",
          "source_text": "路虎和停车位",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "这是你们的路虎，要放好啊！",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "母亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "什么是路虎？",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "路边的老虎。",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "这是越野车。",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "这是你们的停车位，以后车就放在停车位上啊！",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "我睡觉时，要放在台面上。",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "随便。但出去时要小心点，动力很足的，小心撞到人。",
          "file": "zh-cn/2026-08-05-land-rover-and-parking-space_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        }
      ]
