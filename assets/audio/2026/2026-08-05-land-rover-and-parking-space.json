        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Este es vuestro «Lu Hu» (Land Rover). Guardadlo bien, ¿vale?",
          "file": "elevenlabs/es-es/2026-08-05-land-rover-and-parking-space_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
