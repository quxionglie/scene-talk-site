            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "This is your parking spot. From now on, park the car here, okay?",
          "file": "elevenlabs/en-us/2026-08-05-land-rover-and-parking-space_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
