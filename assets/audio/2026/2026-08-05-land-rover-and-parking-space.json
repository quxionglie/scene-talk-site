            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Up to you. But be careful when you take it out. It's pretty powerful, so don't hit anyone.",
          "file": "elevenlabs/en-us/2026-08-05-land-rover-and-parking-space_dialogue_007_en-us.mp3",
