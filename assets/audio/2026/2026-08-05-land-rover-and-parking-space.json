        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "It's an off-road car.",
          "file": "elevenlabs/en-us/2026-08-05-land-rover-and-parking-space_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
