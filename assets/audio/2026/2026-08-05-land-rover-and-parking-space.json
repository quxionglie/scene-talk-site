          "sequence": "001",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Qu'est-ce que « Lu Hu » veut dire ?",
          "file": "elevenlabs/fr-fr/2026-08-05-land-rover-and-parking-space_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:39:04+08:00",
          "generation": {
