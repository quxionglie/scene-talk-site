          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "And Earth is turning too.",
          "file": "elevenlabs/en-us/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
