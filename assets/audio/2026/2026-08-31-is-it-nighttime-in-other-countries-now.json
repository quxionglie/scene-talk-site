            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Et la Terre tourne aussi.",
          "file": "elevenlabs/fr-fr/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
