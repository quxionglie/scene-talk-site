          "type": "dialogue",
          "source_text": "Oui.",
          "file": "elevenlabs/fr-fr/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
