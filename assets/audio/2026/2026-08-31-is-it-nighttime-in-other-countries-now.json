          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:07:51+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Imaginemos que esto es la Tierra. En el lado que ilumina el sol es de día.",
          "file": "elevenlabs/es-es/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:07:54+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Y en el lado opuesto es de noche.",
          "file": "elevenlabs/es-es/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:07:55+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Y además la Tierra está girando.",
          "file": "elevenlabs/es-es/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:07:56+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Por eso por la mañana se va haciendo de día poco a poco y por la noche va oscureciendo.",
