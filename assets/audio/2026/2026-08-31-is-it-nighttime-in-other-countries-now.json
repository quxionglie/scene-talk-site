            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "And it's nighttime on the other side.",
          "file": "elevenlabs/en-us/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
