        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "It's always daytime somewhere and nighttime somewhere else.",
          "file": "elevenlabs/en-us/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
