            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Et de l'autre côté, il fait nuit.",
          "file": "elevenlabs/fr-fr/2026-08-31-is-it-nighttime-in-other-countries-now_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:47:12+08:00",
          "generation": {
