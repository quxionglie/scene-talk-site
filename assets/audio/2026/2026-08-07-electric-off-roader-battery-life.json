          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "This car is twice as big as hers. Bigger cars use more power.",
          "file": "elevenlabs/en-us/2026-08-07-electric-off-roader-battery-life_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
