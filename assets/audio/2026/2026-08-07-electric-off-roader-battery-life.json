      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "越大的车越耗电",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "姐姐说她的车充一次电玩5个小时。",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "我感觉应该不可能啊，最多玩2小时差不多了。",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "你这个充一次玩半个小时。",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "你这个车比她大一倍，越大的车越耗电。",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "越大的车越耗油。",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "越大的车越重嘛！",
          "file": "zh-cn/2026-08-07-electric-off-roader-battery-life_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
