        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "The older girl said her car lasts five hours on one charge.",
          "file": "elevenlabs/en-us/2026-08-07-electric-off-roader-battery-life_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
