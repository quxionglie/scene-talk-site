            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Yours only lasts half an hour on one charge.",
          "file": "elevenlabs/en-us/2026-08-07-electric-off-roader-battery-life_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
