            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Devine quelle heure il est. D'habitude, on arrive ici vers 17 h 35.",
          "file": "elevenlabs/fr-fr/2026-09-09-cant-outrun-an-old-man_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
