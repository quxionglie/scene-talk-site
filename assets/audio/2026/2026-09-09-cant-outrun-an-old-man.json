          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Well, I'm carrying your pencil case and thermos.",
          "file": "elevenlabs/en-us/2026-09-09-cant-outrun-an-old-man_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
