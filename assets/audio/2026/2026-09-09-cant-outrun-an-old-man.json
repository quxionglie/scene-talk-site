        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "You're a young guy, but you still can't outrun an old man like me.",
          "file": "elevenlabs/en-us/2026-09-09-cant-outrun-an-old-man_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
