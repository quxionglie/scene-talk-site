        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Papa, attends-moi.",
          "file": "elevenlabs/fr-fr/2026-09-09-cant-outrun-an-old-man_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
