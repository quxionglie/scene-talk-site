            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "But I'm holding the umbrella!",
          "file": "elevenlabs/en-us/2026-09-09-cant-outrun-an-old-man_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
