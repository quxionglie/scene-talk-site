            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Moi, je porte aussi ta trousse et ta bouteille isotherme.",
          "file": "elevenlabs/fr-fr/2026-09-09-cant-outrun-an-old-man_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:50:43+08:00",
          "generation": {
