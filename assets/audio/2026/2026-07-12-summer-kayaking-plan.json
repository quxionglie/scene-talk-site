            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "On demandera tout à l'heure au Capitaine s'il veut venir.",
          "file": "elevenlabs/fr-fr/2026-07-12-summer-kayaking-plan_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:30:42+08:00",
