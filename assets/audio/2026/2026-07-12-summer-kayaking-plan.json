        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Je veux rendre mes vacances d'été encore plus belles.",
          "file": "elevenlabs/fr-fr/2026-07-12-summer-kayaking-plan_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
