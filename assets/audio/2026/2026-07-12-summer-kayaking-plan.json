            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Make sure you don't fall in the lake. Last time, I was worried you might fall in.",
          "file": "elevenlabs/en-us/2026-07-12-summer-kayaking-plan_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
