          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Alors, on va faire du kayak demain ?",
          "file": "elevenlabs/fr-fr/2026-07-12-summer-kayaking-plan_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
