          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Entonces, ¿vamos en kayak mañana?",
          "file": "elevenlabs/es-es/2026-07-12-summer-kayaking-plan_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
