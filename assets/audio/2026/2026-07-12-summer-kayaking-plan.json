            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "On prendra un kayak pour trois. Ton frère sera devant, moi au milieu et toi derrière.",
          "file": "elevenlabs/fr-fr/2026-07-12-summer-kayaking-plan_dialogue_006_fr-fr.mp3",
