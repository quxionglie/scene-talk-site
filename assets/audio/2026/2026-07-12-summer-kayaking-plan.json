            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "We'll get a three-person kayak. Your brother can sit in front, I'll sit in the middle, and you can sit in the back.",
          "file": "elevenlabs/en-us/2026-07-12-summer-kayaking-plan_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
