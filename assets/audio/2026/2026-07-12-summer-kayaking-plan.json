          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "How about we go kayaking tomorrow, then?",
          "file": "elevenlabs/en-us/2026-07-12-summer-kayaking-plan_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
