          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Fais bien attention à ne pas tomber dans le lac. La dernière fois, j'avais peur que tu tombes à l'eau.",
          "file": "elevenlabs/fr-fr/2026-07-12-summer-kayaking-plan_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
