            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Un briquet.",
            "next_text": "Un autre moyen, c'est une loupe, grande comme une feuille de papier. Quand il y a du soleil, tu prends des feuilles d'arbre et tu tiens la loupe au-dessus pour concentrer la lumière et les enflammer."
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Un autre moyen, c'est une loupe, grande comme une feuille de papier. Quand il y a du soleil, tu prends des feuilles d'arbre et tu tiens la loupe au-dessus pour concentrer la lumière et les enflammer.",
          "file": "elevenlabs/fr-fr/2026-11-06-starting-a-fire-in-the-wild_dialogue_004_fr-fr.mp3",
