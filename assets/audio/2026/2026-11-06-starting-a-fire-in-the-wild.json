            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Un briquet finit par être à court d'essence ou de gaz. Il y a aussi les pierres à feu. On en vend sur Internet.",
