            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Si tu devais survivre dans la nature, tu utiliserais quoi pour allumer un feu ?",
            "next_text": "Un briquet finit par être à court d'essence ou de gaz. Il y a aussi les pierres à feu. On en vend sur Internet."
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "L'essence ou le gaz d'un briquet finit par s'épuiser. Il y a aussi des pierres à feu. Tu peux en acheter sur Internet.",
          "file": "elevenlabs/fr-fr/2026-11-06-starting-a-fire-in-the-wild_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-11-06T19:24:40+08:00",
          "generation": {
            "provider": "ElevenLabs",
