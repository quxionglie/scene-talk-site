            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "note:001",
          "type": "note",
          "source_text": "The father is up earlier than usual.",
          "file": "elevenlabs/2026-09-04-can-people-become-overgrown-with-weeds-too_note_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
