            "speed": 0.9,
            "similarity_boost": 1.0
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Why are you up already?",
          "file": "elevenlabs/2026-09-04-can-people-become-overgrown-with-weeds-too_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
