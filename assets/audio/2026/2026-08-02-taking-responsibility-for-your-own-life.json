          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "It'll be like that for you too later.",
          "file": "elevenlabs/en-us/2026-08-02-taking-responsibility-for-your-own-life_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
