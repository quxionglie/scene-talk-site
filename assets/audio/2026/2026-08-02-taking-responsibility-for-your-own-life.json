            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "He's grown up. The Gaokao is over, and he got into college.",
