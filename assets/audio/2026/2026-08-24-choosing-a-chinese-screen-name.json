          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Jaylen.",
          "file": "elevenlabs/en-us/2026-08-24-choosing-a-chinese-screen-name_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:37:47+08:00",
