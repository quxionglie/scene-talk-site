        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Jaylen.",
          "file": "elevenlabs/2026-08-24-choosing-a-chinese-screen-name_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
