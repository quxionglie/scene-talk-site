        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Think about what you want your screen name to be.",
          "file": "elevenlabs/en-us/2026-08-24-choosing-a-chinese-screen-name_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
