        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "That's your English name. It'd be better to pick a Chinese screen name. Your brother could use \"Scarecrow,\" for example.",
          "file": "elevenlabs/2026-08-24-choosing-a-chinese-screen-name_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
