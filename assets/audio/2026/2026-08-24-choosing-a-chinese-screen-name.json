            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "note:004",
          "type": "note",
          "source_text": "Normally, people just say \"da wang\" (Big Joker), not \"Joker da.\" The child says it this way because he saw the Big Joker labeled \"JOK大\" during a JJ Dou Dizhu match.",
          "file": "elevenlabs/2026-08-24-choosing-a-chinese-screen-name_note_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:37:53+08:00",
          "generation": {
            "provider": "ElevenLabs",
