            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "That's the Big Joker in a deck of cards.",
          "file": "elevenlabs/2026-08-24-choosing-a-chinese-screen-name_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:37:54+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "\"Joker\" can also mean \"clown.\" Sometimes \"clown\" is used as an insult. It's not a nice word. I don't think you should use it.",
          "file": "elevenlabs/2026-08-24-choosing-a-chinese-screen-name_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
