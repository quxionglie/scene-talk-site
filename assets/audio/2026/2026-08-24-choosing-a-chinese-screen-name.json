          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "\"Big Joker\"?",
          "file": "elevenlabs/2026-08-24-choosing-a-chinese-screen-name_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:37:50+08:00",
