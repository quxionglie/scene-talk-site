          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "没必要，装了还容易出故障。",
