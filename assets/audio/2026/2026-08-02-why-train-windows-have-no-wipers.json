          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "就在前面影响你开车的地方装就行。",
          "file": "zh-cn/2026-08-02-why-train-windows-have-no-wipers_dialogue_006_zh-cn.mp3",
