            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Yeah. I told you, when the sun is overhead, it's noon there. It's nighttime here now, but daytime in Europe.",
          "file": "elevenlabs/en-us/2026-08-29-what-time-is-it-in-london_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
