            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¿Dónde se juega este partido?",
          "file": "elevenlabs/es-es/2026-08-29-what-time-is-it-in-london_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:06:52+08:00",
          "generation": {
            "provider": "ElevenLabs",
