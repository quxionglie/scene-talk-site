            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Let me check. It's 2 p.m. in London. It's 9 p.m. here, and it's 2 p.m. there.",
