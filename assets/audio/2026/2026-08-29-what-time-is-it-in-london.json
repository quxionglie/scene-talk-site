            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "¿Allí es de día?",
          "file": "elevenlabs/es-es/2026-08-29-what-time-is-it-in-london_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:06:59+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Sí. Ya te dije que cuando el sol está en lo alto, allí son las doce del mediodía. Aquí ahora es de noche, pero en Europa es de día.",
          "file": "elevenlabs/es-es/2026-08-29-what-time-is-it-in-london_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:07:03+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "¿Qué hora es allí?",
          "file": "elevenlabs/es-es/2026-08-29-what-time-is-it-in-london_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:07:04+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Déjame mirar. En Londres son las dos de la tarde. Aquí son las nueve de la noche y allí las dos.",
          "file": "elevenlabs/es-es/2026-08-29-what-time-is-it-in-london_dialogue_008_es-es.mp3",
          "mime_type": "audio/mpeg",
