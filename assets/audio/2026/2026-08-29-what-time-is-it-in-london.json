          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "What time is it there?",
          "file": "elevenlabs/en-us/2026-08-29-what-time-is-it-in-london_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
