            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Look, right here. One, two, three—the big branches.",
          "file": "elevenlabs/en-us/2026-09-14-taller-than-you_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-14T18:53:34+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "You knocked them all off before. Now it's taller than you—and growing fast, too.",
          "file": "elevenlabs/en-us/2026-09-14-taller-than-you_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
