    {
      "track_id": "zh-CN-mandarin",
      "code": "zh-CN",
      "language": "汉语",
      "variant": "普通话",
      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "长得比你还高",
          "file": "zh-cn/2026-09-14-taller-than-you_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "这个树还蛮高的了！",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "比我还高。",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "以前一片树叶都没有，后面长了个芽就长出来了。",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "你看长了几个杈？",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "哪个杈啊？",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "你看这里，一个、两个、三个，大的树杈。",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "原来全部被你打掉了。现在长得比你还高，长得还快。",
          "file": "zh-cn/2026-09-14-taller-than-you_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        }
      ]
    },
    {
