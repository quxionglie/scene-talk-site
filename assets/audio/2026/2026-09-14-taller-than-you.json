            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¡Este árbol ya ha crecido bastante!",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:28+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Es más alto que yo.",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:29+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Antes no tenía ni una sola hoja. Luego brotó una yema y empezó a crecer de nuevo.",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:32+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Mira, ¿cuántas ramas han crecido?",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:33+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "¿Qué ramas?",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:34+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Mira aquí: una, dos, tres. Las ramas grandes.",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:36+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Antes las rompiste todas. Ahora el árbol es más alto que tú y además crece muy rápido.",
          "file": "elevenlabs/es-es/2026-09-14-taller-than-you_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:39+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "father"
        }
      ]
    },
    {
