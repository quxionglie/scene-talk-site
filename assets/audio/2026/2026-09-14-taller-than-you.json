            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "It's taller than me.",
          "file": "elevenlabs/en-us/2026-09-14-taller-than-you_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-14T18:53:27+08:00",
          "generation": {
            "provider": "ElevenLabs",
