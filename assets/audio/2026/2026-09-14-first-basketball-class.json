          "ai_generated": false,
          "sequence": "002",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "你们的同学很多吗？",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "30个。",
