          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "30个全部报满了吗？",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "只有28个人。",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "有两个人请假了吗？",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "有两个人作业没做完，留了。",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_008_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "008",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "这样子啊！那不是体育课优先吗？",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_009_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "009",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:010",
          "type": "dialogue",
          "source_text": "就要留下来，兴趣班都不上了。",
          "file": "zh-cn/2026-09-14-first-basketball-class_dialogue_010_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "010",
          "speaker": "孩子"
        }
      ]
