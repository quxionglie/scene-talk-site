          },
          "sequence": "008",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "Oh, I see! But shouldn't PE come first?",
          "file": "elevenlabs/en-us/2026-09-14-first-basketball-class_dialogue_009_en-us.mp3",
          "mime_type": "audio/mpeg",
