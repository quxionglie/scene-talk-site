          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Two of them hadn't finished their homework, so they had to stay behind.",
          "file": "elevenlabs/en-us/2026-09-14-first-basketball-class_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
