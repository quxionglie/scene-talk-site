            "similarity_boost": 1.0,
            "stability": 0.5,
            "next_text": "On dirait l’après-midi."
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "On dirait l’après-midi.",
