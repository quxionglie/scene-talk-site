            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "On dirait l’après-midi.",
            "next_text": "Quand le soleil se couche l’après-midi, tu deviens tout sombre."
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Quand le soleil se couche l’après-midi, tu deviens tout sombre.",
