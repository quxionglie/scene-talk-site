            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "En regardant le soleil, tu dirais que c’est le matin ou l’après-midi ?",
            "next_text": "Le soleil de l’après-midi ? Enfin, je veux dire le soleil du soir. Quelle différence tu vois avec celui du matin ?"
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Le soleil de l’après-midi ? Enfin, je veux dire le soleil du soir. Quelle différence tu vois avec celui du matin ?",
