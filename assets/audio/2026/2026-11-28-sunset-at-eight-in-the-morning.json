            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Le soleil de l’après-midi ? Enfin, je veux dire le soleil du soir. Quelle différence tu vois avec celui du matin ?",
