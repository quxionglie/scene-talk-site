            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Al ver el sol, ¿dirías que es por la mañana o por la tarde?",
            "next_text": "¿El sol de la tarde? Bueno, quería decir el del atardecer. ¿Qué diferencia hay entre ese y el de la mañana?"
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "¿El sol de la tarde? Bueno, quería decir el del atardecer. ¿Qué diferencia hay entre ese y el de la mañana?",
          "file": "elevenlabs/es-es/2026-11-28-sunset-at-eight-in-the-morning_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
