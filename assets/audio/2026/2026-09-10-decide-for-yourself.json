          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "\"On the Love of the Lotus\"?",
          "file": "elevenlabs/2026-09-10-decide-for-yourself_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:59:49+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "note:006",
          "type": "note",
          "source_text": "The teacher asked the child to memorize Zhou Dunyi's \"On the Love of the Lotus\" this week.",
          "file": "elevenlabs/2026-09-10-decide-for-yourself_note_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:59:51+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "No, not that one. It's \"Ducks are the first to know when the river warms in spring.\"",
          "file": "elevenlabs/2026-09-10-decide-for-yourself_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:59:53+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "It means that when spring comes, the ducks can tell whether the water is warm or hot.",
          "file": "elevenlabs/2026-09-10-decide-for-yourself_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:59:55+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "008",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "When winter comes, you can tell for yourself whether you feel warm or cold. So I think it's better to let you decide.",
          "file": "elevenlabs/2026-09-10-decide-for-yourself_dialogue_009_en-us.mp3",
          "mime_type": "audio/mpeg",
