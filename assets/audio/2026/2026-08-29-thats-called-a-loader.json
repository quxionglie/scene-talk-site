          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "弟弟"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "你说小的是新的，是吗？小的挖挖机。",
