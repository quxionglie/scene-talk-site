          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "那叫铲车！大的有点旧。",
          "file": "zh-cn/2026-08-29-thats-called-a-loader_dialogue_008_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "008",
          "speaker": "弟弟"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "喔，你那个是铲车。那边有大轮子的叫挖挖机。",
