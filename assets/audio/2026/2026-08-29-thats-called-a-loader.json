          },
          "sequence": "006",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "You said the smaller one is new, right? The little excavator.",
          "file": "elevenlabs/en-us/2026-08-29-thats-called-a-loader_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
