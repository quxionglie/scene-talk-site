          },
          "sequence": "006",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Dijiste que la pequeña es nueva, ¿verdad? La excavadora pequeña.",
