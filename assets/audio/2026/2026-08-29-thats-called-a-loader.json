          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "哥哥"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "你的挖挖机，你哥哥说看挖挖机能看一个下午。是不是？",
