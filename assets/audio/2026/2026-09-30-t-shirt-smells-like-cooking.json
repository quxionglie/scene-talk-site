            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¿Lleva una semana colgada aquí, absorbiendo los olores de la cocina toda la semana?",
