        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Since when are you into cell towers?",
          "file": "elevenlabs/en-us/2026-07-26-signal-tower_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
