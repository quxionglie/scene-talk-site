          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "You need cell towers to get a signal. Otherwise you can't make calls or watch TV!",
          "file": "elevenlabs/en-us/2026-07-26-signal-tower_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
