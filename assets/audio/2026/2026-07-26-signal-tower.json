            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "TV has nothing to do with that. Phone calls use this kind of wireless network.",
          "file": "elevenlabs/en-us/2026-07-26-signal-tower_dialogue_004_en-us.mp3",
