        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¿Desde cuándo te interesan las torres de telefonía?",
          "file": "elevenlabs/es-es/2026-07-26-signal-tower_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:18:03+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Hace falta una torre para tener señal. ¡Si no, no se puede llamar ni ver la televisión!",
          "file": "elevenlabs/es-es/2026-07-26-signal-tower_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:18:05+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "La televisión no tiene nada que ver con esto. Son las llamadas las que usan esta red inalámbrica.",
          "file": "elevenlabs/es-es/2026-07-26-signal-tower_dialogue_004_es-es.mp3",
