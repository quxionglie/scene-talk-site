        {
          "segment_id": "summary",
          "type": "summary",
          "source_text": "There was thunder and rain last night, but the family still didn't head home.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_summary_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
