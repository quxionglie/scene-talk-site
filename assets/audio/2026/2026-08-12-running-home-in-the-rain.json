            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "You should've headed back when it started thundering. Did I still have to come get you?",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:15+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Who knew? Even Niuniu didn't know.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:16+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "note:002",
          "type": "note",
          "source_text": "Niuniu is the nickname of a neighbor's child. A few kids were playing together in the residential compound at the time.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_note_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:18+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Why did Niuniu run back?",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:19+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "note:003",
          "type": "note",
          "source_text": "Dad is asking why Niuniu ran back instead of everyone running back together. Since they were so close, they could've just gone home and showered if they got wet.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_note_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:21+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "When the rain was at its heaviest.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:23+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "note:004",
          "type": "note",
          "source_text": "The child doesn't explain why. He only says when it happened.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_note_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:24+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "So you waited until the rain let up, then came back?",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:26+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Yeah. We ran back.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:27+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "note:006",
          "type": "note",
          "source_text": "They were taking shelter less than 50 meters from their building entrance.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_note_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:29+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Ran back? I thought your mom had your little brother in her arms and ran back with you!",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:34:31+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Mom was holding my little brother's hand, and I ran back by myself.",
          "file": "elevenlabs/2026-08-12-running-home-in-the-rain_dialogue_008_en-us.mp3",
