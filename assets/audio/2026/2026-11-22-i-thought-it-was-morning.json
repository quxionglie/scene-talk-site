          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-11-22T19:11:40+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "next_text": "Es que dormías como un tronco."
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Es que dormías como un tronco.",
          "file": "elevenlabs/es-es/2026-11-22-i-thought-it-was-morning_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
