            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Creía que eran las siete o las ocho de la mañana. ¡Y cuando he mirado la hora, eran las cinco y cinco de la tarde! ¿Por qué crees que me ha pasado eso?",
