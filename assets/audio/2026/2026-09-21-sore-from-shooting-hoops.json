          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "¿Hoy solo practicasteis tiros? ¿No hicisteis entradas botando el balón?",
