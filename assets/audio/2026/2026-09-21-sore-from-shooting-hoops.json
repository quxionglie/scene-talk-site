          "type": "dialogue",
          "source_text": "你们今天只有投篮，没有带球上篮吗？",
          "file": "zh-cn/2026-09-21-sore-from-shooting-hoops_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "只有投篮。",
          "file": "zh-cn/2026-09-21-sore-from-shooting-hoops_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
