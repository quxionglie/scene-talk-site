          "metadata_source": "existing_mp3"
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Papa, j'ai vraiment mal au bras !",
          "file": "elevenlabs/fr-fr/2026-09-21-sore-from-shooting-hoops_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:53:59+08:00",
          "generation": null,
          "sequence": "001",
          "speaker": "child",
          "metadata_source": "existing_mp3"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Après une bonne nuit de sommeil, ça ira mieux.",
          "file": "elevenlabs/fr-fr/2026-09-21-sore-from-shooting-hoops_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:54:00+08:00",
          "generation": null,
          "sequence": "002",
          "speaker": "father",
          "metadata_source": "existing_mp3"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Mais j'ai encore beaucoup de devoirs à faire en rentrant.",
          "file": "elevenlabs/fr-fr/2026-09-21-sore-from-shooting-hoops_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:54:02+08:00",
          "generation": null,
          "sequence": "003",
          "speaker": "child",
          "metadata_source": "existing_mp3"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Vous avez seulement travaillé les tirs aujourd'hui ? Vous n'avez pas fait de doubles pas avec dribble ?",
          "file": "elevenlabs/fr-fr/2026-09-21-sore-from-shooting-hoops_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:54:05+08:00",
          "generation": null,
          "sequence": "004",
          "speaker": "father",
          "metadata_source": "existing_mp3"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Seulement les tirs.",
          "file": "elevenlabs/fr-fr/2026-09-21-sore-from-shooting-hoops_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:54:07+08:00",
          "generation": null,
          "sequence": "005",
          "speaker": "child",
          "metadata_source": "existing_mp3"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "La semaine dernière, c'était le dribble, et cette semaine, les tirs. Peut-être que la semaine prochaine, vous ferez des doubles pas avec dribble.",
          "file": "elevenlabs/fr-fr/2026-09-21-sore-from-shooting-hoops_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
