          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Solo tiros.",
          "file": "elevenlabs/es-es/2026-09-21-sore-from-shooting-hoops_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
