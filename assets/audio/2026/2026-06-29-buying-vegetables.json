            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "vendor"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Alors, un jin de chaque, s'il vous plaît. Ça fait combien en tout ?",
          "file": "elevenlabs/fr-fr/2026-06-29-buying-vegetables_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
