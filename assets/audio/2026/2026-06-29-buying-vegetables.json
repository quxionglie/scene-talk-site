        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Eggplant, long beans, and loofah are 3 yuan per jin. Bitter melon is a bit more, 4 yuan per jin.",
          "file": "elevenlabs/2026-06-29-buying-vegetables_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:19:37+08:00",
          "generation": {
            "provider": "ElevenLabs",
