            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "customer"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "13 yuan total. Cash or scan to pay?",
          "file": "elevenlabs/en-us/2026-06-29-buying-vegetables_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
