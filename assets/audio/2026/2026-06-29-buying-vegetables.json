          },
          "sequence": "003",
          "speaker": "customer"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "13 yuan total. Cash or scan to pay?",
          "file": "elevenlabs/2026-06-29-buying-vegetables_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:19:40+08:00",
