        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Auntie, how much are the eggplant, bitter melon, loofah, and long beans?",
          "file": "elevenlabs/en-us/2026-06-29-buying-vegetables_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
