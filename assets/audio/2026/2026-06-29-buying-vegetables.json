            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "vendor"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Escaneo el código. Gracias, señora.",
          "file": "elevenlabs/es-es/2026-06-29-buying-vegetables_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
