        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Señora, ¿a cuánto están las berenjenas, el melón amargo, las lufas y las judías largas?",
          "file": "elevenlabs/es-es/2026-06-29-buying-vegetables_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
