            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "customer"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Eggplant, long beans, and loofah are 3 yuan per jin. Bitter melon is a bit more, 4 yuan per jin.",
          "file": "elevenlabs/en-us/2026-06-29-buying-vegetables_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:19:37+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "g7LVvkPWALzPxOQbF6OE",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "vendor"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Then one jin of each, please. How much is that total?",
          "file": "elevenlabs/en-us/2026-06-29-buying-vegetables_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
