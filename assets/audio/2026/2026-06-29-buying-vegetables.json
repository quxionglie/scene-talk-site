            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "customer"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Son 13 yuanes en total. ¿Paga en efectivo o escaneando el código?",
          "file": "elevenlabs/es-es/2026-06-29-buying-vegetables_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
