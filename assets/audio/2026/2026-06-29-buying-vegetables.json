        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Les aubergines, les haricots longs et les luffas sont à 3 yuans le jin. Le melon amer est un peu plus cher : 4 yuans le jin.",
          "file": "elevenlabs/fr-fr/2026-06-29-buying-vegetables_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:00+08:00",
