        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Madame, combien coûtent les aubergines, les melons amers, les luffas et les haricots longs ?",
          "file": "elevenlabs/fr-fr/2026-06-29-buying-vegetables_dialogue_001_fr-fr.mp3",
