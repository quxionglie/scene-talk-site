      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "It's So Windy!",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_title_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:59:58+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Out by the road, the wind is really loud—whoosh, whoosh. I can't hear anything through my headphones.",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:02+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Turn it all the way up.",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:04+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Turning it up won't help. All the way up? Are you trying to make me deaf?",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:06+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "The wind is loud at home too, and your mom still won't close the window. It's blowing right in—I'm freezing!",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:08+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "You can hear the wind even here.",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:09+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "That's what autumn is like. The autumn wind sweeps away the fallen leaves.",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:13+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Wow, I'm going to freeze without a jacket.",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:14+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Now you get it!",
          "file": "elevenlabs/en-us/2026-09-10-its-so-windy_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T16:00:16+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "008",
          "speaker": "father"
        }
      ]
    },
    {
      "track_id": "zh-CN-mandarin",
      "code": "zh-CN",
      "language": "汉语",
      "variant": "普通话",
      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "风也太大了",
          "file": "zh-cn/2026-09-10-its-so-windy_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "summary",
          "type": "summary",
          "source_text": "放学回家路上风很大，父亲和孩子聊起了风声。",
          "file": "zh-cn/2026-09-10-its-so-windy_summary_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "到外面马路那里，风声很大，呼呼呼的，我的耳机都听不到声音。",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "你放到最大声。",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "放大声也不行，还放到最大声！你要把我的耳朵打聋，是吗？",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "在家里风声也很大，你妈还不关窗。风在吹，冻死我了！",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "这里都有风声。",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "秋天到了就是这样子。这是秋风扫落叶。",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "哇，没穿外套就要冻死了。",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "你才知道啊！",
          "file": "zh-cn/2026-09-10-its-so-windy_dialogue_008_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "008",
          "speaker": "父亲"
        }
      ]
    },
    {
      "track_id": "es-ES-elevenlabs",
      "code": "es-ES",
      "language": "西班牙语",
      "variant": "西班牙本土西语",
      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "¡Hace muchísimo viento!",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_title_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:29+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ZCh4e9eZSUf41K4cmCEL",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Junto a la carretera, el viento suena muy fuerte, «fuuu, fuuu». No oigo nada por los auriculares.",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:32+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Sube el volumen al máximo.",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:33+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Aunque suba el volumen no servirá. ¿Al máximo? ¿Quieres dejarme sordo?",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:35+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "En casa también se oye mucho el viento y tu madre sigue sin cerrar la ventana. Entra todo el aire, ¡me muero de frío!",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:38+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Incluso aquí se oye el viento.",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:40+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "El otoño es así. El viento otoñal barre las hojas caídas.",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:42+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Uf, me voy a congelar sin chaqueta.",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:43+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "¡Ahora te das cuenta!",
          "file": "elevenlabs/es-es/2026-09-10-its-so-windy_dialogue_008_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:49:45+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "008",
          "speaker": "father"
        }
      ]
    },
    {
      "track_id": "fr-FR-elevenlabs",
      "code": "fr-FR",
      "language": "法语",
      "variant": "法国法语",
      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Il y a vraiment beaucoup de vent !",
          "file": "elevenlabs/fr-fr/2026-09-10-its-so-windy_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:51:11+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "aQROLel5sQbj1vuIVi6B",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Près de la route, le vent fait beaucoup de bruit, « hou, hou ». Je n'entends plus rien dans mon casque.",
          "file": "elevenlabs/fr-fr/2026-09-10-its-so-windy_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:51:14+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Mets le volume au maximum.",
          "file": "elevenlabs/fr-fr/2026-09-10-its-so-windy_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:51:15+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Même en montant le son, ça ne marchera pas. Au maximum ? Tu veux me rendre sourd ?",
          "file": "elevenlabs/fr-fr/2026-09-10-its-so-windy_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:51:17+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "À la maison aussi, le vent fait beaucoup de bruit, et ta mère refuse toujours de fermer la fenêtre. Le vent entre, je meurs de froid !",
          "file": "elevenlabs/fr-fr/2026-09-10-its-so-windy_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:51:20+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Même ici, on entend le vent.",
          "file": "elevenlabs/fr-fr/2026-09-10-its-so-windy_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:51:23+08:00",
