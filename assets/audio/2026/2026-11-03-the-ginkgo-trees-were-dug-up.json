            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Non !",
            "next_text": "Je ne sais pas pourquoi ils les ont arrachés. Et ils n'ont pas bien rebouché les trous. Quelqu'un risque de faire un faux pas et de tomber dedans !"
