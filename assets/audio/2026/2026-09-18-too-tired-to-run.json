            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Después, con botar el balón y correr unos pasos ya estaba muerto de cansancio. Tras jugar media hora, casi no podía correr.",
