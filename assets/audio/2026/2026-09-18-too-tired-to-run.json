          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "你学校旁边公园的篮球场。没去过吗？",
          "file": "zh-cn/2026-09-18-too-tired-to-run_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
