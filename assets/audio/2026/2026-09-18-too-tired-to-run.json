          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "骑车到那边爬那个坡，已经累得差不多了！",
