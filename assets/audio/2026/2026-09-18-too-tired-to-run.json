          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Riding over there and up that hill almost wore me out!",
          "file": "elevenlabs/en-us/2026-09-18-too-tired-to-run_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-18T18:40:45+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Once I got up there, just dribbling the ball and running a few steps wore me out. After playing for half an hour, I could barely run anymore.",
          "file": "elevenlabs/en-us/2026-09-18-too-tired-to-run_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
