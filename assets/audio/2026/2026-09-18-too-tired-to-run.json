          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "¡Solo con ir en bicicleta hasta allí y subir esa cuesta ya estaba casi agotado!",
