          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "In Sichuan dialect, it's \"yīfu\" (clothes).",
          "file": "elevenlabs/en-us/2026-10-09-how-do-you-pronounce-yifu_dialogue_008_en-us.mp3",
