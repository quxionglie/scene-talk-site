            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "\"Yīfú\" (clothes).",
            "next_text": "In Sichuan dialect, it's \"yīfu\" (clothes)."
