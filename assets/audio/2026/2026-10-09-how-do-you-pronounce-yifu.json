            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "In Sichuan dialect, it's \"yīfu\" (clothes).",
            "next_text": "But people will still understand you if you say \"yīfú\" (clothes)."
          },
          "sequence": "009",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:010",
          "type": "dialogue",
          "source_text": "But people will still understand you if you say \"yīfú\" (clothes).",
          "file": "elevenlabs/en-us/2026-10-09-how-do-you-pronounce-yifu_dialogue_010_en-us.mp3",
          "mime_type": "audio/mpeg",
