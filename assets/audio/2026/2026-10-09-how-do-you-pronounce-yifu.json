            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "You got it right the first time. Then you heard your mom say it and got it wrong again! This is so hard.",
            "next_text": "Yes, \"yīfu\" (clothes) is right. That's the standard pronunciation in Mandarin."
          },
          "sequence": "008",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "Yes, \"yīfu\" (clothes) is right. That's the standard pronunciation in Mandarin.",
          "file": "elevenlabs/en-us/2026-10-09-how-do-you-pronounce-yifu_dialogue_009_en-us.mp3",
          "mime_type": "audio/mpeg",
