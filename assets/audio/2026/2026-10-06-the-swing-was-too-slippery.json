            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "The seat was made of wood, and it was too slippery. I didn't hold on tight enough.",
          "file": "elevenlabs/en-us/2026-10-06-the-swing-was-too-slippery_dialogue_008_en-us.mp3",
