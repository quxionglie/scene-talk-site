            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "El asiento era de madera y era demasiado resbaladizo. No me agarré bien.",
