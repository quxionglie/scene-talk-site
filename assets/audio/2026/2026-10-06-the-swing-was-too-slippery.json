            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "¿Hay algo especial allí?",
          "file": "elevenlabs/es-es/2026-10-06-the-swing-was-too-slippery_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T01:22:30+08:00",
