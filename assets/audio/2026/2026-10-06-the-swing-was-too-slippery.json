            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "The slide goes \"rumble, rumble, rumble.\" There's stuff to climb on, too.",
          "file": "elevenlabs/en-us/2026-10-06-the-swing-was-too-slippery_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T09:11:01+08:00",
          "generation": {
            "provider": "ElevenLabs",
