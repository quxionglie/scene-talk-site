        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¿Qué hay de divertido en Cloud Paradise Park?",
          "file": "elevenlabs/es-es/2026-10-06-the-swing-was-too-slippery_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
