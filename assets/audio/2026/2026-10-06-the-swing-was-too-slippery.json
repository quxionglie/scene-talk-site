            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "I've played on everything there. We went there on our class spring outing.",
          "file": "elevenlabs/en-us/2026-10-06-the-swing-was-too-slippery_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
