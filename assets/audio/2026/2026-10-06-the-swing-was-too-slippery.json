            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Last time I went on a swing, I slipped off and landed on my bottom.",
          "file": "elevenlabs/en-us/2026-10-06-the-swing-was-too-slippery_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
