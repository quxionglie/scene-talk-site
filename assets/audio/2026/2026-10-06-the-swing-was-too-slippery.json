          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "La dernière fois que je me suis assis sur la balançoire, j'ai atterri par terre sur les fesses.",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_007_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
