        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Il y a quoi d'amusant à Cloud Paradise Park ?",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T01:22:44+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "J'ai déjà joué à tous les jeux là-bas. On y est allés avec la classe pour la sortie de printemps.",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T01:22:47+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Il y a quelque chose de spécial là-bas ?",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T01:22:49+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Le toboggan fait « clac, clac, clac ». Il y a aussi des trucs pour grimper.",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T09:10:46+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "La dernière fois que je me suis assis sur la balançoire, j'ai glissé et je suis tombé par terre sur les fesses.",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T01:22:54+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Le siège était en bois et il était trop glissant. Je ne me tenais pas assez bien.",
          "file": "elevenlabs/fr-fr/2026-10-06-the-swing-was-too-slippery_dialogue_006_fr-fr.mp3",
