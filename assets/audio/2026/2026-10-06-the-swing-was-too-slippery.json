        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "What's fun to do at Cloud Paradise Park?",
          "file": "elevenlabs/en-us/2026-10-06-the-swing-was-too-slippery_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
