          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "La última vez que me subí al columpio, acabé sentado en el suelo.",
          "file": "elevenlabs/es-es/2026-10-06-the-swing-was-too-slippery_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
