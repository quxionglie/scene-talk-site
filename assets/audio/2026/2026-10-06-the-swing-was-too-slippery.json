            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "El tobogán hace «clac, clac, clac». También hay cosas para trepar.",
          "file": "elevenlabs/es-es/2026-10-06-the-swing-was-too-slippery_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T09:10:55+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "La última vez que me senté en el columpio, me resbalé y acabé sentado en el suelo.",
          "file": "elevenlabs/es-es/2026-10-06-the-swing-was-too-slippery_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-07T01:22:35+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "El asiento era de madera y resbalaba mucho. No me agarré bien.",
          "file": "elevenlabs/es-es/2026-10-06-the-swing-was-too-slippery_dialogue_006_es-es.mp3",
