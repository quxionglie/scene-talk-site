        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Dad, when did you buy this suitcase?",
          "file": "elevenlabs/en-us/2026-08-12-under-200-yuan_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
