            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Ciento y pico yuanes, pero no más de 200.",
          "file": "elevenlabs/es-es/2026-08-12-under-200-yuan_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
