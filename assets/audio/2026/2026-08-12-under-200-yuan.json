          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Un peu plus de 100 yuans, mais pas plus de 200.",
          "file": "elevenlabs/fr-fr/2026-08-12-under-200-yuan_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
