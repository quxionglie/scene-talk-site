            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¡Ni siquiera habías nacido cuando la compré! Ya no recuerdo cuándo fue. Hace muchos años.",
