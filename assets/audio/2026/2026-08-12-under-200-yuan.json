          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Pourquoi ?",
          "file": "elevenlabs/fr-fr/2026-08-12-under-200-yuan_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:41:06+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
