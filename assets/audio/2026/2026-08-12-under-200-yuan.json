        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "爸爸，行李箱什么时候买的？",
          "file": "zh-cn/2026-08-12-under-200-yuan_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "我买的时候你没出生呢！我都忘记什么时候买的了，很多年了。",
          "file": "zh-cn/2026-08-12-under-200-yuan_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "行李箱贵吗？",
          "file": "zh-cn/2026-08-12-under-200-yuan_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "100多左右，不会超过200。",
          "file": "zh-cn/2026-08-12-under-200-yuan_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "为什么？",
          "file": "zh-cn/2026-08-12-under-200-yuan_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
