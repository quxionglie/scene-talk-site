        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Papa, quand est-ce que tu as acheté cette valise ?",
          "file": "elevenlabs/fr-fr/2026-08-12-under-200-yuan_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:40:59+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Tu n'étais même pas né quand je l'ai achetée ! Je ne me souviens plus quand c'était. Il y a très longtemps.",
          "file": "elevenlabs/fr-fr/2026-08-12-under-200-yuan_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:41:01+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Elle était chère, la valise ?",
          "file": "elevenlabs/fr-fr/2026-08-12-under-200-yuan_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
