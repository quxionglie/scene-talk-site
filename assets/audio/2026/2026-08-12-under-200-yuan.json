        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Papá, ¿cuándo compraste esta maleta?",
          "file": "elevenlabs/es-es/2026-08-12-under-200-yuan_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
