          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Why?",
          "file": "elevenlabs/en-us/2026-08-12-under-200-yuan_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
