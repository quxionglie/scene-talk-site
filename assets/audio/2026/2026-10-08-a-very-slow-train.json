        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Dad, I heard you've been on a really slow train.",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T16:09:59+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "That's called a green train. It took 35 hours to get from Shenzhen to Chengdu, if I remember right.",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:35+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "I only took it once, and I don't want to take it again.",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:38+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Why?",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:40+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Why? Because it was so slow! Way too slow. My butt went numb from sitting so long.",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:42+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "It was hard to sleep, too. People kept walking up and down selling things.",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:44+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "How about I take you on one next time?",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:46+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "No, I don't want to.",
          "file": "elevenlabs/en-us/2026-10-08-a-very-slow-train_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:36:48+08:00",
