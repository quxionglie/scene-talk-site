            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Papa, j'ai entendu dire que tu avais pris un train vraiment lent.",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T16:10:02+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Ça s'appelle un train vert. Il fallait 35 heures pour aller de Shenzhen à Chengdu, si je me souviens bien.",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:39:44+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Je l'ai pris une seule fois, et je n'ai pas envie de le reprendre.",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:39:46+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Pourquoi ?",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:39:47+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Pourquoi ? Parce qu'il était très lent ! Beaucoup trop lent. À force de rester assis, j'avais les fesses engourdies.",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:39:53+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "C'était aussi difficile de dormir. Des gens passaient sans arrêt pour vendre des choses.",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:39:57+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Et si je t'emmenais en prendre un la prochaine fois ?",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_007_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-08T11:40:00+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Non, j'ai pas envie.",
          "file": "elevenlabs/fr-fr/2026-10-08-a-very-slow-train_dialogue_008_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
