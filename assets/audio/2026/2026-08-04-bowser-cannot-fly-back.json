        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "爸爸，酷霸王飞不起来！",
          "file": "zh-cn/2026-08-04-bowser-cannot-fly-back_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
