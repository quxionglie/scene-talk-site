            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "La velocidad de reacción también forma parte de la agilidad. Cuanta más agilidad tienes, más rápido reaccionas.",
