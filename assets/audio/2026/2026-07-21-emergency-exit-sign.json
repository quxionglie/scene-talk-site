            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Entonces, ¿qué significa esa señal al lado de la puerta? ¡La del hombre que corre!",
