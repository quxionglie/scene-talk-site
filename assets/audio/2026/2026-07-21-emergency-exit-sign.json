          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "那门口旁边那个标志是什么意思？人在跑的那个!",
          "file": "zh-cn/2026-07-21-emergency-exit-sign_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "安全出口。",
