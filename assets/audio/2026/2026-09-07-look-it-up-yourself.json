            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Is that in the dictionary?",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:21+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "You need to figure that out for yourself. Other people aren't always right.",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:23+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Why do you think your teacher tells you to use a dictionary? Your Xinhua Dictionary is useful after all.",
