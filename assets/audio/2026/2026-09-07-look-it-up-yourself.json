          "type": "summary",
          "source_text": "A father corrects a synonym he got wrong the day before and encourages his child to look things up in a dictionary.",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_summary_en-us.mp3",
          "mime_type": "audio/mpeg",
