            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "I don't think \"yiding\" (definitely) is quite the right synonym for \"ziran\" (naturally)!",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:13+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "note:001",
          "type": "note",
          "source_text": "The example sentence is: \"As a local, he naturally knows which parts of the forest have lots of mushrooms.\"",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_note_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:15+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ktkP7Nsj67dw2zcplQYt",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Better synonyms are \"dangran\" (of course), \"liying\" (as one should), and \"guran\" (admittedly). Writing \"yiding\" might be wrong.",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:17+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "But didn't you say it was \"yiding\"?",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:18+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "You need to learn to use a dictionary!",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
