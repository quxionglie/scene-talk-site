            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "008",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "The big one is called The Contemporary Chinese Dictionary. That's the one you'll use in high school.",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_009_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
