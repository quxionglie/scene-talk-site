      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Look It Up Yourself",
          "file": "elevenlabs/en-us/2026-09-07-look-it-up-yourself_title_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:45:10+08:00",
