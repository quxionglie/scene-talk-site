          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "You mean the big Xinhua Dictionary?",
          "file": "elevenlabs/2026-09-07-look-it-up-yourself_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
