          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "I was by myself.",
          "file": "elevenlabs/en-us/2026-08-29-dream-in-the-elevator_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
