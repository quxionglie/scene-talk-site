          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "What did you dream about? Can you tell me?",
          "file": "elevenlabs/en-us/2026-08-29-dream-in-the-elevator_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
