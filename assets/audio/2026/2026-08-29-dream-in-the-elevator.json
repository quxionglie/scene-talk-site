      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "电梯里的梦",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "我昨天做了一个梦。",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "什么梦啊？能告诉我吗？",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "我坐电梯被困住了，别人让我按铃铛！",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "铃铛好像是紧急呼叫。",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "你坐电梯一般不是跟爸爸妈妈坐的吗？",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "我一个人坐的。",
          "file": "zh-cn/2026-08-29-dream-in-the-elevator_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        }
      ]
