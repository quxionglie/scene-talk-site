        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Un rêve dans un ascenseur",
          "file": "elevenlabs/fr-fr/2026-08-29-dream-in-the-elevator_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
