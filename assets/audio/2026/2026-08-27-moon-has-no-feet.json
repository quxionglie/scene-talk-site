            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Maybe you'll learn why the moon moves someday. I can't really explain it right now.",
          "file": "elevenlabs/en-us/2026-08-27-moon-has-no-feet_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
