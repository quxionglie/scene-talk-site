        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¿Cómo es que se ha movido la luna?",
          "file": "elevenlabs/es-es/2026-08-27-moon-has-no-feet_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:06:00+08:00",
