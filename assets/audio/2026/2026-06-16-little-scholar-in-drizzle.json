          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "I'm out of breath.",
          "file": "elevenlabs/en-us/2026-06-16-little-scholar-in-drizzle_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
