          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "下雨了，我帮你打伞。",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "我自己来。",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "你这个样子像古代的小书生。",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "你还能走吗？",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "我没气了。",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "你知道没气是什么意思吗？",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "没气就是没有力气了。",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_008_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "008",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "那你还能走这么久？",
          "file": "zh-cn/2026-06-16-little-scholar-in-drizzle_dialogue_009_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
