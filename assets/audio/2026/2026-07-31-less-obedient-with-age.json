            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "I mean Grandpa and Grandma.",
          "file": "elevenlabs/en-us/2026-07-31-less-obedient-with-age_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
