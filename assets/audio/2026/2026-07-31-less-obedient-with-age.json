            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "What do you mean?",
          "file": "elevenlabs/en-us/2026-07-31-less-obedient-with-age_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
