          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "When you're cooking, tell them to go do their own stuff!",
          "file": "elevenlabs/en-us/2026-07-31-less-obedient-with-age_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:29:03+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Oh, they just don't want you to feel neglected!",
          "file": "elevenlabs/en-us/2026-07-31-less-obedient-with-age_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
