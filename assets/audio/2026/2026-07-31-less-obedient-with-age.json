      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "越老越不听话",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "为什么越老越不听话了？",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "什么意思？",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "我说爷爷奶奶。",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "你炒菜的时候，叫他们干自己的事情去！",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "喔，他们是怕你受委屈了！",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "城市和农村的环境不一样。",
          "file": "zh-cn/2026-07-31-less-obedient-with-age_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "父亲"
        }
      ]
