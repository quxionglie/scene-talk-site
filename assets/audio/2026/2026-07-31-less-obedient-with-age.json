          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "aQROLel5sQbj1vuIVi6B",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Pourquoi est-ce que les gens écoutent de moins en moins en vieillissant ?",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:35:01+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Qu'est-ce que tu veux dire ?",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:35:02+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Je parle de grand-père et grand-mère.",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:35:04+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Quand tu cuisines, dis-leur de s'occuper de leurs affaires !",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:35:06+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Oh, c'est juste qu'ils ne veulent pas que tu te sentes négligé !",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:35:08+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Les conditions ne sont pas les mêmes en ville et à la campagne.",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
