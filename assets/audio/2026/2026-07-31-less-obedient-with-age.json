      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Plus ils vieillissent, moins ils écoutent",
          "file": "elevenlabs/fr-fr/2026-07-31-less-obedient-with-age_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
