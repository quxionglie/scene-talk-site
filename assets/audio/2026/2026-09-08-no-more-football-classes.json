          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "note:003",
          "type": "note",
          "source_text": "The school-run classes are free, while those run by outside providers charge fees and are very expensive.",
          "file": "elevenlabs/2026-09-08-no-more-football-classes_note_003_en-us.mp3",
          "mime_type": "audio/mpeg",
