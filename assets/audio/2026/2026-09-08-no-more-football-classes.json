            "similarity_boost": 1.0
          },
          "sequence": "003"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "So you probably can't sign up for football. Does that mean the school basketball class is your only option?",
          "file": "elevenlabs/2026-09-08-no-more-football-classes_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
