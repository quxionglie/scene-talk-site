          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "我不喜欢篮球。",
          "file": "zh-cn/2026-09-08-no-more-football-classes_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "那你不报也不行。你要报一个运动啊，不然你的眼睛受不了的。",
