      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Ya no hay clases de fútbol",
          "file": "elevenlabs/es-es/2026-09-08-no-more-football-classes_title_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:48:39+08:00",
          "generation": {
            "provider": "ElevenLabs",
