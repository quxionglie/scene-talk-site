        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Looks like they don't offer that football class at school anymore.",
          "file": "elevenlabs/en-us/2026-09-08-no-more-football-classes_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
