          "source_text": "没有足球课了",
          "file": "zh-cn/2026-09-08-no-more-football-classes_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "你那个校内足球课好像没有了！",
          "file": "zh-cn/2026-09-08-no-more-football-classes_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
