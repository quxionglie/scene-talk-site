            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "C'est parce que l'ascenseur de notre immeuble est trop bruyant.",
          "file": "elevenlabs/fr-fr/2026-09-03-x-is-pronounced-cha_dialogue_004_fr-fr.mp3",
