            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "M4? That sounds kind of like the name of a gun.",
          "file": "elevenlabs/en-us/2026-09-03-x-is-pronounced-cha_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
