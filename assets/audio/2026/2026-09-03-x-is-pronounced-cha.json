      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "X读作叉",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "我戴上耳机，外面的汽车声音都听不到了！",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "听听歌，安安静静的多好。",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "你每次都喜欢戴耳机。",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "因为家里那个电梯太吵了。",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "这款耳机都出到 XM6 了，我这个是 XM4。",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "M4？跟枪的名字差不多。",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "索尼的 XM4，前面的 X，我们就读作“叉”（chā）。",
          "file": "zh-cn/2026-09-03-x-is-pronounced-cha_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        }
      ]
