        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "J'ai mis mon casque et maintenant, je n'entends plus du tout les voitures dehors !",
          "file": "elevenlabs/fr-fr/2026-09-03-x-is-pronounced-cha_dialogue_001_fr-fr.mp3",
