            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Ils ont déjà sorti le XM6. Le mien est un XM4.",
          "file": "elevenlabs/fr-fr/2026-09-03-x-is-pronounced-cha_dialogue_005_fr-fr.mp3",
