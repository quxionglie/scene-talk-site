          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "C'est tellement agréable et calme d'écouter de la musique.",
          "file": "elevenlabs/fr-fr/2026-09-03-x-is-pronounced-cha_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
