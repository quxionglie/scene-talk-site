        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "It's Sony's XM4. We call the X at the beginning \"cha\" (cross) in Chinese.",
          "file": "elevenlabs/2026-09-03-x-is-pronounced-cha_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
