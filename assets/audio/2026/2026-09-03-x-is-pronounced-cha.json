            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "It's Sony's XM4. We call the X at the beginning \"cha\" (cross) in Chinese.",
