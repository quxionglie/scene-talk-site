            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "They've already released the XM6. Mine's an XM4.",
