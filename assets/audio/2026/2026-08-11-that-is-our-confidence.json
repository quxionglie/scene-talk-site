          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "I care about other people's height, not my own.",
          "file": "elevenlabs/2026-08-11-that-is-our-confidence_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
