          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "You're already above the average height for your age.",
          "file": "elevenlabs/2026-08-11-that-is-our-confidence_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
