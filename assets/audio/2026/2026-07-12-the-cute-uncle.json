          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Maybe you got there a little late, then.",
          "file": "elevenlabs/en-us/2026-07-12-the-cute-uncle_dialogue_002_en-us.mp3",
