          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "008",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "I meant my uncle's son. He was kind of cute. I even touched him...",
          "file": "elevenlabs/en-us/2026-07-12-the-cute-uncle_dialogue_009_en-us.mp3",
          "mime_type": "audio/mpeg",
