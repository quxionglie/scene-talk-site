          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Yeah. My uncle's... kind of cute?",
          "file": "elevenlabs/en-us/2026-07-12-the-cute-uncle_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-12T15:23:28+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "You mean your uncle was kind of cute?",
          "file": "elevenlabs/en-us/2026-07-12-the-cute-uncle_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
