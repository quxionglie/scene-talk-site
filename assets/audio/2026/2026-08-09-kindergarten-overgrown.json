      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Le terrain de l'école maternelle est envahi par les herbes",
          "file": "elevenlabs/fr-fr/2026-08-09-kindergarten-overgrown_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:39:41+08:00",
