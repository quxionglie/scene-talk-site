        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¿Ya ha crecido hierba?",
          "file": "elevenlabs/es-es/2026-08-09-kindergarten-overgrown_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
