      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "幼儿园长草了",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "长草没有？",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "真的长草了。",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "可以养鱼了！",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "水是下雨积的，没法修学校了！学校都没法修了怎么办？",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "儿子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "旁边有个商场10年了都没建起来！",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "都是骗子。",
          "file": "zh-cn/2026-08-09-kindergarten-overgrown_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
