            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "son"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "We could raise fish there now!",
          "file": "elevenlabs/en-us/2026-08-09-kindergarten-overgrown_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
