          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "¡Tengo que llevarla a casa para lavarla! También hay un formulario que tenemos que devolver la semana que viene.",
