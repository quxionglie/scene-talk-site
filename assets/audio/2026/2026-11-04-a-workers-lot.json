            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Tu sais à quel point il peut pleuvoir ?",
            "next_text": "Il pleut très fort pendant une journée, voire deux. Quand un typhon passe, il pleut généralement pendant plusieurs jours."
          },
          "sequence": "007",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Il pleut très fort pendant une journée, voire deux. Quand un typhon passe, il pleut généralement pendant plusieurs jours.",
