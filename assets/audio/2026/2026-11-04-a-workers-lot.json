            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Les typhons, c'est juste de l'air, non ?",
            "next_text": "Tu sais à quel point il peut pleuvoir ?"
