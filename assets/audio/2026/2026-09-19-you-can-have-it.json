          },
          "sequence": "001",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Maintenant, je ne peux même plus boire de thé.",
          "file": "elevenlabs/fr-fr/2026-09-19-you-can-have-it_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
