            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Il va encore falloir acheter une nouvelle tasse. Ah, attends, il y en a une autre dans la cuisine. C'était un cadeau d'anniversaire de l'école !",
          "file": "elevenlabs/fr-fr/2026-09-19-you-can-have-it_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:53:43+08:00",
