          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Elle est sous le stérilisateur à vaisselle.",
          "file": "elevenlabs/fr-fr/2026-09-19-you-can-have-it_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:53:46+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "hFgOzpmS0CMtL2to8sAl",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Celle-ci est plus jolie. Tu peux me la donner ? Sinon, j'en achèterai une nouvelle.",
