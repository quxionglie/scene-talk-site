            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Ahora tendremos que gastar dinero en otra taza. Ah, espera, hay otra en la cocina. ¡Fue un regalo de cumpleaños de la escuela!",
          "file": "elevenlabs/es-es/2026-09-19-you-can-have-it_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:51:41+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "RgXx32WYOGrd7gFNifSf",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Déjame verla.",
