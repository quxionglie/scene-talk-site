        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Recoge los trozos del suelo con un pañuelo de papel.",
          "file": "elevenlabs/es-es/2026-09-19-you-can-have-it_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
