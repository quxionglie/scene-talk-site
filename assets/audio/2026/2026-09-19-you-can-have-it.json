          },
          "sequence": "001",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Ahora ni siquiera puedo tomar té.",
          "file": "elevenlabs/es-es/2026-09-19-you-can-have-it_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
