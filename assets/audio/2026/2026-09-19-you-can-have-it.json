            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Ramasse simplement les morceaux par terre avec un mouchoir en papier.",
          "file": "elevenlabs/fr-fr/2026-09-19-you-can-have-it_dialogue_001_fr-fr.mp3",
