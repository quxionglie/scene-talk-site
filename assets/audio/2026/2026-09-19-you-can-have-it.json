            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Fais-moi voir.",
