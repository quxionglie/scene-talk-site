            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Está debajo del esterilizador de vajilla.",
          "file": "elevenlabs/es-es/2026-09-19-you-can-have-it_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:51:43+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "RgXx32WYOGrd7gFNifSf",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "mother"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Esta es más bonita. ¿Me la regalas? Si no, compraré una nueva.",
          "file": "elevenlabs/es-es/2026-09-19-you-can-have-it_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
