            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "C’est quoi, « yuanhai » (littéralement, mer originelle) ?",
            "next_text": "Un typhon peut faire s’écrouler une maison ?"
