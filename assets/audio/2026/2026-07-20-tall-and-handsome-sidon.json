      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "又帅又高的希多",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "阿沅叫胖哥也行，因为阿沅的“沅”，肚子很圆就很胖。",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "是吗？",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "嗯，希多吸的是水。",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "那露珠呢？",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "露珠，嗯？我想知道小鸟的名字叫什么？",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "你看一下游戏里的名人录，反正名字比较难念。",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "你是喜欢小鸟还是胖子？",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "我喜欢希多！",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_008_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "008",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:009",
          "type": "dialogue",
          "source_text": "为什么？",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_009_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "009",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:010",
          "type": "dialogue",
          "source_text": "希多长得又帅又高！",
          "file": "zh-cn/2026-07-20-tall-and-handsome-sidon_dialogue_010_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "010",
          "speaker": "孩子"
        }
      ]
    },
