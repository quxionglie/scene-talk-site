            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "¡Me gusta Sidon!",
          "file": "elevenlabs/es-es/2026-07-20-tall-and-handsome-sidon_dialogue_008_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
