            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Check the Character Profiles in the game. His name's pretty hard to pronounce anyway.",
          "file": "elevenlabs/en-us/2026-07-20-tall-and-handsome-sidon_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
