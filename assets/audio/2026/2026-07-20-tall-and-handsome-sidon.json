            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Riju... hmm? I wonder what the little bird's name is.",
          "file": "elevenlabs/en-us/2026-07-20-tall-and-handsome-sidon_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
