            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "What about Riju?",
          "file": "elevenlabs/en-us/2026-07-20-tall-and-handsome-sidon_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
