            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Yeah. The \"Xi\" in Sidon's Chinese name sounds like \"xi\" (suck). He sucks up water.",
          "file": "elevenlabs/en-us/2026-07-20-tall-and-handsome-sidon_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
