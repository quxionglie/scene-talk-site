        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "如果家里面只让你一个人。",
          "file": "zh-cn/2026-10-15-happy-birthday-to-me_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
