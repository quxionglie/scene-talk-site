        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "啥意思？",
          "file": "zh-cn/2026-10-15-happy-birthday-to-me_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "一个人生活，一个人煮饭，一个人上学，一个人工作。",
          "file": "zh-cn/2026-10-15-happy-birthday-to-me_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "不要。",
          "file": "zh-cn/2026-10-15-happy-birthday-to-me_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "不要？以后你就这样子了。",
