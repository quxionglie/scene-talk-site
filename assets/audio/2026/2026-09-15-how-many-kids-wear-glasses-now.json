            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Look at you kids now. Three out of those six are nearsighted and wear glasses. And some kids are nearsighted but don't wear glasses.",
          "file": "elevenlabs/2026-09-15-how-many-kids-wear-glasses-now_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
