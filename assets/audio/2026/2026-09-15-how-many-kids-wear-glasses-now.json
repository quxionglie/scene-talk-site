        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "When I was in elementary school, none of us wore glasses, though we all became nearsighted later.",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-15T19:45:17+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Why?",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-15T19:45:19+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "7QN34D2r3hCNwbOYIeK0",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "I don't know!",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-15T19:45:20+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Maybe some of us were already nearsighted. I was already a little nearsighted, but I didn't get glasses until my second year of junior high.",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-15T19:45:24+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Look at you kids now. Three out of those six are nearsighted and wear glasses. And some kids are nearsighted but don't wear glasses.",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-15T19:45:27+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "So how many kids in your class wear glasses? Have you counted?",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-09-15T19:45:29+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "gOupLcAkjEnguROwi4oS",
            "model_id": "eleven_multilingual_v2",
            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "Haven't counted.",
          "file": "elevenlabs/en-us/2026-09-15-how-many-kids-wear-glasses-now_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
