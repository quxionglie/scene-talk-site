      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "¿Cuántos niños llevan gafas ahora?",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_title_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:40+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "ZCh4e9eZSUf41K4cmCEL",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Cuando estaba en primaria, ninguno llevaba gafas, aunque después todos acabamos siendo miopes.",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:43+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¿Por qué?",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:44+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "¡No lo sé!",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:45+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Quizá algunos ya éramos miopes. Yo ya tenía un poco de miopía, pero no me hicieron gafas hasta segundo de secundaria.",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:48+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Mira a los niños de ahora. Tres de esos seis son miopes y llevan gafas. Y hay otros que son miopes pero no las llevan.",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:51+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Entonces, ¿cuántos niños de tu clase llevan gafas? ¿Los has contado?",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:53+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "No los he contado.",
          "file": "elevenlabs/es-es/2026-09-15-how-many-kids-wear-glasses-now_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T18:50:54+08:00",
          "generation": {
            "provider": "ElevenLabs",
