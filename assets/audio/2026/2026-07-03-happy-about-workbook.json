        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Escuchamos «The Sad Pacific» todos los días. Basta de cosas tristes. ¿Tienes algo alegre que contarme?",
          "file": "elevenlabs/es-es/2026-07-03-happy-about-workbook_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:46+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Mamá me ha comprado un cuaderno de ejercicios.",
          "file": "elevenlabs/es-es/2026-07-03-happy-about-workbook_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:48+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Estamos de vacaciones. Los demás niños solo quieren jugar todo el día, ¡y tú todavía quieres hacer ejercicios!",
          "file": "elevenlabs/es-es/2026-07-03-happy-about-workbook_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:51+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Ya se me saltan las lágrimas. ¿Tú qué crees: tengo ganas de llorar o de reír?",
          "file": "elevenlabs/es-es/2026-07-03-happy-about-workbook_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:54+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "¿Llorar?",
          "file": "elevenlabs/es-es/2026-07-03-happy-about-workbook_dialogue_005_es-es.mp3",
