          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "It's school break. Other kids just want to play all day, but you still want to do workbook problems!",
          "file": "elevenlabs/en-us/2026-07-03-happy-about-workbook_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
