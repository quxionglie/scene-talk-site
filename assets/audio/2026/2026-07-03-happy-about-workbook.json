            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "On écoute « The Sad Pacific » tous les jours. Assez parlé de choses tristes. Tu as quelque chose de joyeux à me raconter ?",
          "file": "elevenlabs/fr-fr/2026-07-03-happy-about-workbook_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:28:29+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Maman m'a acheté un cahier d'exercices.",
          "file": "elevenlabs/fr-fr/2026-07-03-happy-about-workbook_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:28:30+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "C'est les vacances. Les autres enfants veulent seulement jouer toute la journée, et toi, tu veux encore faire des exercices !",
          "file": "elevenlabs/fr-fr/2026-07-03-happy-about-workbook_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:28:33+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "J'en ai les larmes aux yeux. À ton avis, j'ai envie de pleurer ou de rire ?",
          "file": "elevenlabs/fr-fr/2026-07-03-happy-about-workbook_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
