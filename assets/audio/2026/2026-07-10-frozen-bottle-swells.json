            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "La prochaine fois, mets moins d'eau dans la bouteille, sinon elle finira encore comme ça.",
          "file": "elevenlabs/fr-fr/2026-07-10-frozen-bottle-swells_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
