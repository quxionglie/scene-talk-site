          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Sors-la, qu'on regarde.",
          "file": "elevenlabs/fr-fr/2026-07-10-frozen-bottle-swells_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:29:57+08:00",
          "generation": {
