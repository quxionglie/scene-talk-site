          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "La próxima vez pon menos agua en la botella, o volverá a quedar así.",
          "file": "elevenlabs/es-es/2026-07-10-frozen-bottle-swells_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
