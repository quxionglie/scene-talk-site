        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "L'eau de ma bouteille est complètement gelée.",
          "file": "elevenlabs/fr-fr/2026-07-10-frozen-bottle-swells_dialogue_001_fr-fr.mp3",
