        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Sácala para que la veamos.",
          "file": "elevenlabs/es-es/2026-07-10-frozen-bottle-swells_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
