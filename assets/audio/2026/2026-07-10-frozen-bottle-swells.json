            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Menos mal que es de plástico; si no, habría estallado.",
