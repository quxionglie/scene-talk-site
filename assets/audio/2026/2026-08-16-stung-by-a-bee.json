            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¿Qué «ju» quieres decir? ¿El de «ju ji qiang» (rifle de francotirador) o el de «ju liu» (detención)?",
          "file": "elevenlabs/es-es/2026-08-16-stung-by-a-bee_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:02:37+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Yo solo conozco «zhe» (picar), como en «una abeja me picó».",
          "file": "elevenlabs/es-es/2026-08-16-stung-by-a-bee_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:02:39+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "«Ju» es dialecto de Sichuan. Equivale a «zhe» (picar) en mandarín.",
          "file": "elevenlabs/es-es/2026-08-16-stung-by-a-bee_dialogue_004_es-es.mp3",
