            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "\"Ju\" (sting) is a Sichuan dialect word. It means \"zhe\" (sting) in Mandarin.",
