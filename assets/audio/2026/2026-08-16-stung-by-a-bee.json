        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Una abeja me ha «ju» (picado).",
          "file": "elevenlabs/es-es/2026-08-16-stung-by-a-bee_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
