            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "« Ju » vient du dialecte du Sichuan. Cela correspond à « zhe » (piquer) en mandarin.",
