            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "De quel « ju » parles-tu ? Celui de « ju ji qiang » (fusil de précision) ou celui de « ju liu » (détention) ?",
          "file": "elevenlabs/fr-fr/2026-08-16-stung-by-a-bee_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:41:58+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Je ne connais que « zhe » (piquer), comme dans « se faire piquer par une abeille ».",
          "file": "elevenlabs/fr-fr/2026-08-16-stung-by-a-bee_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
