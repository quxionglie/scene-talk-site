        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "A bee \"ju\" (stung) me.",
          "file": "elevenlabs/en-us/2026-08-16-stung-by-a-bee_dialogue_001_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
