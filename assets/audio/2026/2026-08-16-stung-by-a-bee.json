            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Which \"ju\" do you mean—the one in \"ju ji qiang\" (sniper rifle) or the one in \"ju liu\" (detention)?",
          "file": "elevenlabs/en-us/2026-08-16-stung-by-a-bee_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T17:20:50+08:00",
          "generation": {
            "provider": "ElevenLabs",
