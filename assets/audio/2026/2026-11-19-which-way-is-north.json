            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "next_text": "Puede que las señales de la calle estén bien. Pero aquí, en la urbanización, ponen el norte y el sur donde les parece. ¡Están todas mal!"
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "A lo mejor las señales de la calle están bien. Pero aquí en la urbanización han puesto el norte y el sur al tuntún. ¡Están todas mal!",
          "file": "elevenlabs/es-es/2026-11-19-which-way-is-north_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
