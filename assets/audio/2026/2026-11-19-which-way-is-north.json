            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Si le haces caso a esa señal, vas a ir por donde no es.",
            "next_text": "¿Por dónde crees que queda el norte?"
          },
          "sequence": "002",
          "speaker": "father"
        },
