            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Si le haces caso a esa señal, vas a ir por donde no es.",
          "file": "elevenlabs/es-es/2026-11-19-which-way-is-north_dialogue_001_es-es.mp3",
