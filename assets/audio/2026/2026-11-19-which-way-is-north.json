            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "next_text": "Les panneaux dans la rue, ça va peut-être. Mais ici, dans la résidence, ils indiquent le nord et le sud n'importe comment. Ils sont tous faux, ces panneaux !"
          },
          "sequence": "001",
          "speaker": "child"
