          },
          "sequence": "006",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "When you're deciding what to call someone, go with the younger term. They'll be happy.",
          "file": "elevenlabs/en-us/2026-09-02-make-them-sound-younger_dialogue_007_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
