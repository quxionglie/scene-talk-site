          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Don't make him sound old!",
          "file": "elevenlabs/2026-09-02-make-them-sound-younger_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
