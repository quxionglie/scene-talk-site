            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Calling someone \"shushu\" (uncle) makes them sound older.",
          "file": "elevenlabs/en-us/2026-09-02-make-them-sound-younger_dialogue_008_en-us.mp3",
          "mime_type": "audio/mpeg",
