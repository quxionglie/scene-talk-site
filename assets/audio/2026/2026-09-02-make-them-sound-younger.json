            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Papá, ¿debería llamar a ese hombre «gege» (hermano mayor) o «shushu» (tío)?",
          "file": "elevenlabs/es-es/2026-09-02-make-them-sound-younger_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
