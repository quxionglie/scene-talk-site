          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "The one who just gave you that flyer.",
          "file": "elevenlabs/en-us/2026-09-02-make-them-sound-younger_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
