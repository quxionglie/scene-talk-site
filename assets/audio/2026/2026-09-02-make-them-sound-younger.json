          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "You can call him \"shushu\" (uncle).",
          "file": "elevenlabs/en-us/2026-09-02-make-them-sound-younger_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
