      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Le séisme de la nuit dernière",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:09+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "aQROLel5sQbj1vuIVi6B",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Tu as senti le séisme la nuit dernière ?",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:10+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Non, je ne l'ai pas senti.",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:12+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "older brother"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "C'était un séisme de magnitude 5,5 à Yibin, pas très loin d'ici.",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:15+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Je me suis même levé pour voir ce qui se passait. Si ça tremblait encore, j'allais descendre en courant.",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:17+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Il ne faut pas prendre l'ascenseur.",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:25:19+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "GgV5QStPLpmkN7FOHJtY",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "J'ai aussi dit que, si on ne pouvait pas sortir, on se mettrait à l'abri sous la table.",
          "file": "elevenlabs/fr-fr/2026-06-29-earthquake-at-night_dialogue_006_fr-fr.mp3",
