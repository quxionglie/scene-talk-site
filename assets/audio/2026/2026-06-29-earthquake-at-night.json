          },
          "sequence": "004"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "You can't take the elevator.",
          "file": "elevenlabs/2026-06-29-earthquake-at-night_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
