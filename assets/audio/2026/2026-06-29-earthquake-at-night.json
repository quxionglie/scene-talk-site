            "output_format": "mp3_44100_128",
            "speed": 0.9,
            "similarity_boost": 1.0
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "note:004",
          "type": "note",
          "source_text": "Here, \"zài lái\" means another shake or aftershock.",
          "file": "elevenlabs/2026-06-29-earthquake-at-night_note_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
