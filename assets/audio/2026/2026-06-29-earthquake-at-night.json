          },
          "sequence": "005",
          "speaker": "child 1"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "I was thinking, if we couldn't get out, we could hide under the table.",
          "file": "elevenlabs/2026-06-29-earthquake-at-night_dialogue_006_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
