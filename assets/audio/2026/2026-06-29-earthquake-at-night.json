      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "昨晚地震",
          "file": "zh-cn/2026-06-29-earthquake-at-night_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "昨晚地震有感觉到吗？",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "没感觉。",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "哥哥"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "宜宾5.5级，离我们不太远。",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "我还起来观察了一下，再来就要跑下楼了。",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "不能坐电梯。",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "弟弟"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "我还说跑不了就躲在桌子下面呢。",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "你们老师有教过？",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_007_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "007",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "要躲在三角的地方。",
          "file": "zh-cn/2026-06-29-earthquake-at-night_dialogue_008_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "008",
          "speaker": "弟弟"
        }
      ]
    },
    {
