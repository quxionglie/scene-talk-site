            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¿Notaste el terremoto de anoche?",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:18+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "No, no lo noté.",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:19+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "older brother"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Fue un terremoto de magnitud 5,5 en Yibin, no muy lejos de aquí.",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:21+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Incluso me levanté para ver qué pasaba. Si volvía a temblar, iba a bajar corriendo.",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:24+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "No se puede usar el ascensor.",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:25+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "y6WtESLj18d0diFRruBs",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "También dije que, si no podíamos salir, nos refugiaríamos debajo de la mesa.",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:28+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "006",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:007",
          "type": "dialogue",
          "source_text": "¿Os lo han enseñado los profesores?",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_007_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:12:29+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "007",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:008",
          "type": "dialogue",
          "source_text": "Hay que esconderse en un espacio triangular.",
          "file": "elevenlabs/es-es/2026-06-29-earthquake-at-night_dialogue_008_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
