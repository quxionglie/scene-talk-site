            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Ils doivent pomper l'eau jusque dans une cuve. Ensuite, les brumisateurs puisent l'eau dans la cuve.",
            "next_text": "Je pensais qu'un camion apportait l'eau tous les jours. Même pas. Et ils ne remplissent pas non plus la cuve avec de l'eau du robinet."
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Je pensais qu'un camion apportait l'eau tous les jours. Même pas. Et ils ne remplissent pas non plus la cuve avec de l'eau du robinet.",
          "file": "elevenlabs/fr-fr/2026-11-20-where-does-the-water-come-from_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
