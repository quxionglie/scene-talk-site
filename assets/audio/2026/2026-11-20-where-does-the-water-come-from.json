            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Je pensais qu'un camion apportait l'eau tous les jours. Même pas. Et ils ne remplissent pas non plus la cuve avec de l'eau du robinet.",
