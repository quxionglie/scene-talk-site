            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "D'un gros tuyau ?",
            "next_text": "Ils doivent pomper l'eau jusque dans une cuve. Ensuite, les brumisateurs puisent l'eau dans la cuve."
          },
          "sequence": "003",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Ils doivent pomper l'eau jusque dans une cuve. Ensuite, les brumisateurs puisent l'eau dans la cuve.",
          "file": "elevenlabs/fr-fr/2026-11-20-where-does-the-water-come-from_dialogue_004_fr-fr.mp3",
