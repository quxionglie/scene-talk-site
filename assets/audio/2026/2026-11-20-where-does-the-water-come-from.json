            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Tiens, les jets se sont arrêtés de ce côté-là aussi. À ton avis, elle vient d'où, cette eau ?",
          "file": "elevenlabs/fr-fr/2026-11-20-where-does-the-water-come-from_dialogue_001_fr-fr.mp3",
