            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Ah, tu crois qu'ils pompent l'eau qui est en bas ? Regarde, c'est bien un tuyau, là en bas ?",
            "next_text": "Mais elle est plutôt sale, cette eau, non ? Ne passe plus par là quand les jets sont en marche. Je croyais que c'était de l'eau du robinet. Eh bien non."
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Mais elle est plutôt sale, cette eau, non ? Ne passe plus par là quand les jets sont en marche. Je croyais que c'était de l'eau du robinet. Eh bien non.",
          "file": "elevenlabs/fr-fr/2026-11-20-where-does-the-water-come-from_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
