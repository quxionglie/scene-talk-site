            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5,
            "previous_text": "Tiens, les jets se sont arrêtés de ce côté-là aussi. À ton avis, elle vient d'où, cette eau ?",
            "next_text": "Ah, tu crois qu'ils pompent l'eau qui est en bas ? Regarde, c'est bien un tuyau, là en bas ?"
          },
          "sequence": "002",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Ah, tu crois qu'ils pompent l'eau qui est en bas ? Regarde, c'est bien un tuyau, là en bas ?",
          "file": "elevenlabs/fr-fr/2026-11-20-where-does-the-water-come-from_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
