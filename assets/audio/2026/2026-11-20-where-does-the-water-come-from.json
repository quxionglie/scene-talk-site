        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "D'un gros tuyau ?",
          "file": "elevenlabs/fr-fr/2026-11-20-where-does-the-water-come-from_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
