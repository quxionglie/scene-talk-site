          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Pourquoi vous êtes sortis aujourd'hui alors qu'il pleuvait ?",
          "file": "elevenlabs/fr-fr/2026-10-05-going-out-and-coming-back_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
