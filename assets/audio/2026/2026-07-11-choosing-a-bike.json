        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Esta otra es de Giant. Se puede usar a partir de 1,45 metros.",
          "file": "elevenlabs/es-es/2026-07-11-choosing-a-bike_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:14:24+08:00",
