        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "He derrotado al jefe del Templo del Rayo.",
          "file": "elevenlabs/es-es/2026-07-20-beating-the-lightning-temple-boss_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:16:17+08:00",
