        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Battre le boss du Temple de la Foudre",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:32:17+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "aQROLel5sQbj1vuIVi6B",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "J'ai battu le boss du Temple de la Foudre.",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:32:19+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Bravo ! Il t'a fallu combien d'essais ?",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_dialogue_002_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:32:20+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Je suis mort une fois, mais j'ai fini par le battre. Ça m'a pris beaucoup de temps.",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_dialogue_003_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:32:23+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Un ennemi ordinaire m'a sauté dessus et m'a tué. Ce n'est pas le boss qui m'a tué !",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:32:25+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "nr2EGJNe96rzn9FRlTId",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "Il t'a attaqué par-derrière ?",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:32:26+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "UBXZKOKbt62aLQHhc1Jm",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "Non, il m'a attaqué de face. Je regardais les arbres au-dessus et je ne faisais pas attention au sol.",
          "file": "elevenlabs/fr-fr/2026-07-20-beating-the-lightning-temple-boss_dialogue_006_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
