      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "打赢雷之神殿的 Boss",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_title_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "我打赢了雷之神殿的 Boss。",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "这么强！打了几次？",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "死了一次，后面才打赢。我用了好多时间。",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "003",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "我就是被小怪扑过来打死的，不是 Boss 打死的！",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_dialogue_004_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "004",
          "speaker": "孩子"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "从后面偷袭的？",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_dialogue_005_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "005",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "正面打的，我正在看上面的树，没注意到地面的情况。",
          "file": "zh-cn/2026-07-20-beating-the-lightning-temple-boss_dialogue_006_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "006",
          "speaker": "孩子"
        }
      ]
