            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "¡Qué bien! ¿Cuántos intentos necesitaste?",
          "file": "elevenlabs/es-es/2026-07-20-beating-the-lightning-temple-boss_dialogue_002_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:16:19+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Morí una vez, pero al final lo derroté. Me llevó mucho tiempo.",
          "file": "elevenlabs/es-es/2026-07-20-beating-the-lightning-temple-boss_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:16:21+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Un enemigo normal se me echó encima y me mató. ¡No fue el jefe!",
          "file": "elevenlabs/es-es/2026-07-20-beating-the-lightning-temple-boss_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:16:23+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "¿Te atacó por la espalda?",
          "file": "elevenlabs/es-es/2026-07-20-beating-the-lightning-temple-boss_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:16:25+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "No, me atacó de frente. Estaba mirando los árboles de arriba y no prestaba atención al suelo.",
          "file": "elevenlabs/es-es/2026-07-20-beating-the-lightning-temple-boss_dialogue_006_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:16:27+08:00",
