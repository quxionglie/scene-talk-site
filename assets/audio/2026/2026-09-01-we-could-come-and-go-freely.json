        {
          "segment_id": "title",
          "type": "title",
          "source_text": "We Could Come and Go Freely",
          "file": "elevenlabs/en-us/2026-09-01-we-could-come-and-go-freely_title_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
