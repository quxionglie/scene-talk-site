        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "爸爸，看大云！",
          "file": "zh-cn/2026-07-28-big-cloud-and-cotton-candy_dialogue_001_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "001",
          "speaker": "弟弟"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "其他人很少会叫大云的，都是叫白云、乌云！",
          "file": "zh-cn/2026-07-28-big-cloud-and-cotton-candy_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "父亲"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "云能吃吗？",
          "file": "zh-cn/2026-07-28-big-cloud-and-cotton-candy_dialogue_003_zh-cn.mp3",
          "mime_type": "audio/mpeg",
