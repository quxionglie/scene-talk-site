            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¡Papá, mira, una nube enorme!",
          "file": "elevenlabs/es-es/2026-07-28-big-cloud-and-cotton-candy_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:18:11+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "y6WtESLj18d0diFRruBs",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "001",
          "speaker": "younger brother"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "La gente casi nunca dice «nube grande». Suele decir «nube blanca» o «nube oscura».",
