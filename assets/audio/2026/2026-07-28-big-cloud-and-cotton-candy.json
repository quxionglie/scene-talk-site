          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "older brother"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Tú ya has comido algodón de azúcar, ¿no?",
          "file": "elevenlabs/es-es/2026-07-28-big-cloud-and-cotton-candy_dialogue_004_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:18:17+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "LlZr3QuzbW4WrPjgATHG",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "¡Sí!",
          "file": "elevenlabs/es-es/2026-07-28-big-cloud-and-cotton-candy_dialogue_005_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:18:18+08:00",
          "generation": {
            "provider": "ElevenLabs",
            "voice_id": "Nh2zY9kknu6z4pZy6FhD",
            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "005",
          "speaker": "older brother"
        },
        {
          "segment_id": "dialogue:006",
          "type": "dialogue",
          "source_text": "¡Es incluso más dulce que el azúcar blanco de casa!",
          "file": "elevenlabs/es-es/2026-07-28-big-cloud-and-cotton-candy_dialogue_006_es-es.mp3",
