      "clips": [
        {
          "segment_id": "title",
          "type": "title",
          "source_text": "Quel âge a Link ?",
          "file": "elevenlabs/fr-fr/2026-08-20-how-old-is-link_title_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:42:38+08:00",
          "generation": {
