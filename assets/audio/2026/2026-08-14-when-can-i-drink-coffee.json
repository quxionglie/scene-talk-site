          },
          "sequence": "001",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "Don't drink from the mug. There's coffee in it! Drink from the thermos.",
          "file": "elevenlabs/en-us/2026-08-14-when-can-i-drink-coffee_dialogue_002_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
