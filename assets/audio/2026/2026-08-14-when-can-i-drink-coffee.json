            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "Je peux boire ton eau ?",
          "file": "elevenlabs/fr-fr/2026-08-14-when-can-i-drink-coffee_dialogue_001_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
