            "model_id": "eleven_v4",
            "output_format": "mp3_44100_128",
            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Tu sais quand tu pourras commencer à boire du café et du thé ?",
          "file": "elevenlabs/fr-fr/2026-08-14-when-can-i-drink-coffee_dialogue_004_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
