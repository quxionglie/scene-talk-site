            "similarity_boost": 1.0,
            "stability": 0.5
          },
          "sequence": "004",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "À partir de 12 ans.",
          "file": "elevenlabs/fr-fr/2026-08-14-when-can-i-drink-coffee_dialogue_005_fr-fr.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
