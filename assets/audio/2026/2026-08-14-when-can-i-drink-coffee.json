            "stability": 0.5
          }
        },
        {
          "segment_id": "dialogue:001",
          "type": "dialogue",
          "source_text": "¿Puedo beber de tu agua?",
          "file": "elevenlabs/es-es/2026-08-14-when-can-i-drink-coffee_dialogue_001_es-es.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
          "generated_at": "2026-10-06T19:02:04+08:00",
