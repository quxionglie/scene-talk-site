            "similarity_boost": 1.0
          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "The water in the thermos is too hot.",
          "file": "elevenlabs/en-us/2026-08-14-when-can-i-drink-coffee_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
