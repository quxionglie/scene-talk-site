          },
          "sequence": "003",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Do you know when you can start drinking coffee and tea?",
          "file": "elevenlabs/en-us/2026-08-14-when-can-i-drink-coffee_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
