        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Mamá era la que no quería correr.",
          "file": "elevenlabs/es-es/2026-08-12-no-umbrella-keep-running_dialogue_003_es-es.mp3",
          "mime_type": "audio/mpeg",
