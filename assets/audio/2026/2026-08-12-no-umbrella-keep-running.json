        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "C'est maman qui ne voulait pas courir.",
          "file": "elevenlabs/fr-fr/2026-08-12-no-umbrella-keep-running_dialogue_003_fr-fr.mp3",
