          "sequence": "003"
        },
        {
          "segment_id": "dialogue:004",
          "type": "dialogue",
          "source_text": "Oh, \"Bu jiao bu zao\" (not anxious or impatient)!",
          "file": "elevenlabs/2026-08-31-neither-anxious-nor-impatient_dialogue_004_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
