          },
          "sequence": "002",
          "speaker": "father"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "Think of a hammer and a kitchen knife. You can't use a hammer to chop vegetables!",
          "file": "elevenlabs/2026-08-30-hammering-vegetables_dialogue_003_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
