          },
          "sequence": "004",
          "speaker": "child"
        },
        {
          "segment_id": "dialogue:005",
          "type": "dialogue",
          "source_text": "I used to avoid Stone Pebblits whenever I saw them because none of my weapons worked.",
          "file": "elevenlabs/2026-08-30-hammering-vegetables_dialogue_005_en-us.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": true,
