        {
          "segment_id": "dialogue:002",
          "type": "dialogue",
          "source_text": "这种青色的3元一斤，红的4元一斤。",
          "file": "zh-cn/2026-06-29-buying-plums_dialogue_002_zh-cn.mp3",
          "mime_type": "audio/mpeg",
          "ai_generated": false,
          "sequence": "002",
          "speaker": "阿姨"
        },
        {
          "segment_id": "dialogue:003",
          "type": "dialogue",
          "source_text": "这两种帮我各称一斤，一起7块吧。",
